# Copie para .env.local (git-ignorado) e ajuste se necessário.
# URL do backend modulos/recomendacao-escolas. Local (uvicorn): valor abaixo.
# Depois do deploy, aponte para a URL pública (ex.: prefixo /recomendacao-escolas
# do backend unificado no Railway).
VITE_API_RECOMENDACAO_URL=http://localhost:8000

# URL do backend modulos/inscricao (POST /inscricoes -- persiste de verdade).
# Local (uvicorn app.main:app --reload --port 8003): valor abaixo. Depois do
# deploy, aponte para a URL pública (ex.: prefixo /inscricao do backend
# unificado no Railway).
VITE_API_INSCRICAO_URL=http://localhost:8003
