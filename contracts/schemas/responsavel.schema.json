{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "responsavel.schema.json",
  "title": "Responsavel",
  "type": "object",
  "required": ["cpf"],
  "properties": {
    "cpf": {
      "type": "string",
      "pattern": "^[0-9]{11}$",
      "description": "CPF do responsável, somente dígitos, sem pontuação."
    }
  },
  "additionalProperties": false
}
